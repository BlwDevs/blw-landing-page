# Configuração do Google Sheets
# URL do Google Apps Script após deploy
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec

# WhatsApp (opcional - usado como fallback)
VITE_WHATSAPP_NUMBER=5587988685309

# RD Station Marketing
# Chave de API PÚBLICA — RD Station > Integrações > API > "Chave de API pública".
# Sem ela o formulário continua funcionando, só não registra a conversão na RD.
VITE_RD_STATION_API_KEY=

# Opcional: identificador do campo personalizado que recebe a mensagem do formulário.
# Crie o campo antes na RD (Configurações > Campos personalizados) e use o
# identificador de API dele, ex.: cf_mensagem.
# Se o campo não existir na conta, a RD rejeita a conversão inteira — por isso o
# padrão é vazio (mensagem não enviada).
VITE_RD_STATION_MESSAGE_FIELD=
